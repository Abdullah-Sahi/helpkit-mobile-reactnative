# Copy to .env.local (which git ignores) and fill in. Both values are public, not secrets: the App ID
# is built into every app that uses it.
#
# The App ID: the HelpKit dashboard, Settings, then the Mobile app card (it appears after a first
# save). 22 characters.
EXPO_PUBLIC_HELPKIT_APP_ID=
# HelpKit's own address: where the dashboard is served. Plain http is allowed only in development
# and only for a local address; docs/development.md says how a phone reaches this computer.
EXPO_PUBLIC_HELPKIT_HOST=http://localhost:3212
