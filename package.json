{
  "name": "helpkit-react-native",
  "version": "0.1.0",
  "description": "Your HelpKit help center in a native sheet inside your React Native app, on iOS and Android.",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "helpkit-rn-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "expo",
    "help-center",
    "helpkit",
    "ios",
    "android"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "check:pack": "npm run build && npm pack --dry-run && publint && attw --pack . --profile esm-only",
    "print-injection": "npm run build && node scripts/print-injection.mjs",
    "example": "npm run --workspace helpkit-react-native-example",
    "check:bundle": "node scripts/check-bundle.mjs example/dist/android example/dist/ios"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.81.0",
    "react-native-safe-area-context": ">=4.10.0",
    "react-native-webview": ">=13.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "publint": "^0.3.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "workspaces": [
    "example"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__}/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
